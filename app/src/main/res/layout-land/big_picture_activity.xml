

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.winlator.cmod.bigpicture.TiledBackgroundView
        android:id="@+id/parallaxBackgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>


<LinearLayout
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">


    <!-- Horizontal layout for cover art and game details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- Large ImageView for cover art with fixed aspect ratio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <!-- Cover Art -->
            <ImageView
                android:id="@+id/IVCoverArt"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:padding="16dp"
                android:src="@drawable/icon_gamepad"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/playButton"
                android:nextFocusDown="@id/RecyclerView"
                android:elevation="8dp"
            />

            <!-- Upload Custom Cover Art prompt (fixed to be below the cover art) -->
            <TextView
                android:id="@+id/uploadText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zh_hc_click_to_upload_custom_cover_art_8be651a4"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:visibility="gone"
                android:padding="8dp"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/darkBackgroundContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:background="@drawable/bg_transparent_dark"
            android:padding="8dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Settings Button -->
                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icon_rb"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/zh_hc_settings_c7f73bb5"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusDown="@id/IVCoverArt"
                    android:nextFocusLeft="@id/IVCoverArt"
                    />

                <!-- TextView for Settings label, below the button -->
                <TextView
                    android:id="@+id/settingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zh_hc_settings_c7f73bb5"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:layout_below="@id/settingsButton"
                    android:layout_alignEnd="@id/settingsButton"
                    android:layout_marginTop="-12dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="6sp"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeStepGranularity="1sp"
                    android:adjustViewBounds="true" />


                <!-- Title section aligned to the top -->
                <TextView
                    android:id="@+id/TVGameTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceLarge"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/settingsButton"
                android:layout_marginTop="8dp"
                android:paddingBottom="16dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:adjustViewBounds="true" />
            </RelativeLayout>



        <!-- NestedScrollView for game details -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true">

                <!-- Extras Information with labels bold and values indented -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >

                    <!-- Graphics Driver -->
                    <TextView
                        android:id="@+id/TVGraphicsDriverLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_graphics_driver_ca4537f6"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:id="@+id/TVGraphicsDriver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:textColor="@android:color/white"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@id/playButton"
                    />

                    <!-- Graphics Driver Version -->
                    <TextView
                        android:id="@+id/TVGraphicsDriverVersionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_driver_version_1ee41dfa"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:id="@+id/TVGraphicsDriverVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:textColor="@android:color/white" />

                    <!-- DX Wrapper -->
                    <TextView
                        android:id="@+id/TVDXWrapperLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_dx_wrapper_8112373c"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:id="@+id/TVDXWrapper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:textColor="@android:color/white" />

                    <!-- DXVK/VKD3D Config -->
                    <TextView
                        android:id="@+id/TVDXWrapperConfigLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_dxvk_vkd3d_config_86f2ceb5"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:id="@+id/TVDXWrapperConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:textColor="@android:color/white" />

                    <!-- Audio Driver -->
                    <TextView
                        android:id="@+id/TVAudioDriverLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_audio_driver_a92756e4"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:id="@+id/TVAudioDriver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:textColor="@android:color/white" />

                    <!-- Box64 Preset -->
                    <TextView
                        android:id="@+id/TVBox64PresetLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_box64_preset_a9cdce45"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:id="@+id/TVBox64Preset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="16dp"
                        android:textColor="@android:color/white" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Play Button and Playtime Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:gravity="bottom">

                <ImageButton
                    android:id="@+id/playButton"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:src="@drawable/icon_play"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/IVCoverArt"
                    android:nextFocusUp="@id/TVGraphicsDriver"
                    android:nextFocusDown="@id/RecyclerView"
                />

                <!-- Space between play button and play details -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/TVPlayCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingRight="16dp"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/TVPlaytime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="@android:color/white"
                        android:paddingRight="16dp"
                        android:paddingBottom="32dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- RecyclerView for carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:layout_marginTop="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@id/playButton"
        android:background="@drawable/bg_transparent_dark"
    />

    <!-- TextView for displaying the empty state message -->
    <TextView
        android:id="@+id/TVEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/zh_hc_nothing_here_launch_your_container_and_create_a__e4185895"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone"
        android:padding="16dp" />

</LinearLayout>

    <!-- Settings View (Initially hidden, off-screen) -->
    <!-- ScrollView wrapped in a container LinearLayout, with settings hidden by default -->
    <LinearLayout
        android:id="@+id/settingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">  <!-- Ensure the entire settings container is hidden by default -->

    <!-- New container for the settings section with dark transparent background -->
        <LinearLayout
            android:id="@+id/settingsDarkBackgroundContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_transparent_dark"
            android:padding="16dp"
            android:layout_gravity="center"
            android:layout_margin="16dp">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">


                    <ImageButton
                        android:id="@+id/backButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/icon_rb"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/zh_hc_back_b52b36b7"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        />

                    <TextView
                        android:id="@+id/backLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_back_b52b36b7"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:layout_below="@id/backButton"
                        android:layout_alignEnd="@id/backButton"
                        android:layout_marginTop="-12dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:adjustViewBounds="true" />

                <!-- Field label for Settings -->
                <TextView
                    android:id="@+id/TVSettingsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zh_hc_settings_c7f73bb5"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                </RelativeLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <!-- Single LinearLayout as a direct child of ScrollView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">


                <!-- Settings Group (FieldSet) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- YouTube URL Setting -->
                    <TextView
                        android:id="@+id/youtubeUrlLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_youtube_video_url_not_all_youtube_videos_are_sup_1e80db58"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:padding="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/youtubeUrlInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="text"
                            android:hint="@string/zh_hc_enter_youtube_url_e0f71696"
                            android:background="@android:drawable/edit_text"
                            android:textColor="@android:color/black" />

                        <Button
                            android:id="@+id/loadVideoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_set_bg_music_71017f48"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- MP3 Selection -->
                    <Button
                        android:id="@+id/selectMp3Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_select_mp3_689cd6a7"
                        android:layout_marginBottom="16dp" />

                    <!-- Reset MP3 Button -->
                    <Button
                        android:id="@+id/resetMp3Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_reset_mp3_3307b109"
                        android:layout_marginBottom="16dp" />

                    <!-- Music Source Selection -->
                    <TextView
                        android:id="@+id/musicSourceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_select_music_source_05196cd8"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:padding="8dp" />

                    <RadioGroup
                        android:id="@+id/musicSourceGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/youtubeRadioButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YouTube"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/mp3RadioButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MP3" />
                    </RadioGroup>

                    <!-- Disable BG Music Button -->
                    <Button
                        android:id="@+id/disableBgMusicButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_disable_bg_music_51d13649"
                        android:layout_marginTop="16dp" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                <TextView
                    android:id="@+id/themeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zh_hc_background_settings_123b12c5"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:padding="8dp" />

                <RadioGroup
                    android:id="@+id/animationSelectorGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbCustomWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_custom_wallpaper_b42860c8" />

                    <Button
                        android:id="@+id/selectWallpaperButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_select_wallpaper_7eeb5179"
                        android:visibility="gone" />

                    <RadioButton
                        android:id="@+id/rbNoAnimation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_no_background_e47fc484" />


                    <RadioButton
                        android:id="@+id/rbDefaultAnimation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_wave_a24d6011" />

                    <RadioButton
                        android:id="@+id/rbGearAnimation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_gear_def2b5f8" />

                    <RadioButton
                        android:id="@+id/rbQuiltAnimation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_quilt_01aa4888" />

                    <RadioButton
                        android:id="@+id/rbFolderAnimation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_folder_30baa249" />

                </RadioGroup>

                    <Button
                        android:id="@+id/selectPngFolderButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_select_animation_png_folder_358899e1" />

                    <TextView
                        android:id="@+id/parallaxModeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_parallax_mode_1ca43d3b"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:padding="8dp" />

                    <RadioGroup
                        android:id="@+id/parallaxModeGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rbParallaxOff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_off_e3de5ab0" />

                        <RadioButton
                            android:id="@+id/rbParallaxSlow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_slow_33dcec9c" />

                        <RadioButton
                            android:id="@+id/rbParallaxDefault"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_default_808d7dca"
                            android:checked="true" />

                        <RadioButton
                            android:id="@+id/rbParallaxFast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_fast_8db6a2f1" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/frameSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_animation_speed_365e300e"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:padding="8dp" />

                    <SeekBar
                        android:id="@+id/frameSpeedSeekBar"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="66" />


                </LinearLayout>

            </LinearLayout>
        </ScrollView>
            </LinearLayout>
        </LinearLayout>




    <!-- WebView for playing YouTube video, on top of all elements, invisible but present -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false" />
</FrameLayout>