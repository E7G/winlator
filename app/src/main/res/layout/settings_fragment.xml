<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui_glass_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ui_glass_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="76dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:text="@string/zh_hc_app_settings_d2a517dd"
                android:textColor="@color/ui_text_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/ui_enhanced_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="14dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/ui_icon_button_bg">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ui_nav_settings" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_runtime_and_interface_564c0689"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/zh_hc_presets_paths_input_and_diagnostics_a73434de"
                        android:textColor="@color/ui_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/box64_preset" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SBox64Preset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:spinnerMode="dialog" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="start"
                        android:paddingTop="4dp">

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTAddBox64Preset"
                            android:tooltipText="Add"
                            android:src="@drawable/icon_add" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTEditBox64Preset"
                            android:tooltipText="Edit"
                            android:src="@drawable/icon_edit" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="Duplicate"
                            android:id="@+id/BTDuplicateBox64Preset"
                            android:src="@drawable/icon_duplicate" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="Remove"
                            android:id="@+id/BTRemoveBox64Preset"
                            android:layout_marginRight="0dp"
                            android:src="@drawable/icon_remove" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTExportBox64Preset"
                            android:tooltipText="Export"
                            android:layout_marginRight="0dp"
                            android:src="@drawable/icon_export" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="Import"
                            android:id="@+id/BTImportBox64Preset"
                            android:layout_marginRight="0dp"
                            android:src="@drawable/icon_popup_menu_download" />

                        <Space
                            android:layout_width="75dp"
                            android:layout_height="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/TVBox64"
                    style="@style/FieldSetLabel"
                    android:text="@string/box64" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fexcore_preset" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SFEXCorePreset"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:spinnerMode="dialog" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="start"
                        android:paddingTop="4dp">

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTAddFEXCorePreset"
                            android:tooltipText="Add"
                            android:src="@drawable/icon_add" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTEditFEXCorePreset"
                            android:tooltipText="Edit"
                            android:src="@drawable/icon_edit" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="Duplicate"
                            android:id="@+id/BTDuplicateFEXCorePreset"
                            android:src="@drawable/icon_duplicate" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="Remove"
                            android:id="@+id/BTRemoveFEXCorePreset"
                            android:layout_marginRight="0dp"
                            android:src="@drawable/icon_remove" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:id="@+id/BTExportFEXCorePreset"
                            android:tooltipText="Export"
                            android:layout_marginRight="0dp"
                            android:src="@drawable/icon_export" />

                        <ImageButton
                            style="@style/ListMenuButton"
                            android:tooltipText="Import"
                            android:id="@+id/BTImportFEXCorePreset"
                            android:layout_marginRight="0dp"
                            android:src="@drawable/icon_popup_menu_download" />

                        <Space
                            android:layout_width="75dp"
                            android:layout_height="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/TVFEXCore"
                    style="@style/FieldSetLabel"
                    android:text="@string/fexcore_config" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/midi_sound_font" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/SMIDISoundFont"
                            style="@style/ComboBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/BTInstallSF"
                            style="@style/ListMenuButton"
                            android:src="@drawable/icon_add" />

                        <ImageButton
                            android:id="@+id/BTRemoveSF"
                            style="@style/ListMenuButton"
                            android:layout_marginRight="0dp"
                            android:src="@drawable/icon_remove" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/TVSound"
                    style="@style/FieldSetLabel"
                    android:text="@string/sound" />
            </FrameLayout>

            <!-- Theme Settings -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <CheckBox
                        android:id="@+id/CBDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_enable_dark_mode_0baea2ce" />
                </LinearLayout>
                <TextView
                    android:id="@+id/TVTheme"
                    style="@style/FieldSetLabel"
                    android:text="@string/zh_hc_theme_a797e309" />
            </FrameLayout>

            <!-- Shortcuts -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout style="@style/FieldSet">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_winlator_path_b1ee11f4" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/TVWinlatorPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTChooseWinlatorPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_choose_path_e86f6c32" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_shortcut_export_path_8915cb1b" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/TVShortcutExportPath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <Button
                            style="@style/ButtonNeutral"
                            android:id="@+id/BTChooseShortcutExportPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_choose_path_e86f6c32" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/TVShortcutSettings"
                    style="@style/FieldSetLabel"
                    android:text="@string/zh_hc_path_settings_d964758b" />
            </FrameLayout>


            <!-- Big Picture Mode -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">

                    <!-- SteamGridDB API Key Section -->
                    <CheckBox
                        android:id="@+id/CBEnableBigPictureMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_enable_big_picture_mode_on_app_launch_cbad5807" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout style="@style/FieldSet">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <CheckBox
                                    android:id="@+id/CBEnableCustomApiKey"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/zh_hc_set_steamgrid_api_key_cover_art_2c219e33" />

                                <ImageView
                                    android:id="@+id/BTHelpApiKey"
                                    style="@style/HelpButton"
                                    android:contentDescription="@string/help_steamgrid"
                                    android:src="@drawable/icon_help" />
                            </LinearLayout>

                            <EditText
                                android:id="@+id/ETCustomApiKey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="@string/zh_hc_enter_your_api_key_here_6e6995aa"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/TVCustomApiKey"
                            style="@style/FieldSetLabel"
                            android:text="@string/zh_hc_steamgriddb_api_key_282d9a20" />
                    </FrameLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/TVBigPictureMode"
                    style="@style/FieldSetLabel"
                    android:text="@string/zh_hc_big_picture_mode_4f5447e9" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/cursor_speed"/>

                        <TextView
                            android:id="@+id/TVCursorSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/SBCursorSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="10"
                        android:max="200" />

                    <CheckBox
                        android:id="@+id/CBUseDRI3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_dri3_extension"
                        android:layout_marginTop="8dp" />

                    <CheckBox
                        android:id="@+id/CBUseXR"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_xr"
                        android:layout_marginTop="8dp" />

                    <!-- New Cursor Lock Checkbox -->
                    <CheckBox
                        android:id="@+id/CBCursorLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_capture_external_pointer_60e5e580"
                        android:layout_marginTop="8dp" />

                    <!-- New Xinput Toggle Checkbox -->
                    <CheckBox
                        android:id="@+id/CBXinputToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zh_hc_disable_xinput_used_for_exclusive_m_kb_support_c8a77178"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/TVXServer"
                    style="@style/FieldSetLabel"
                    android:text="@string/xserver" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <CheckBox
                        android:id="@+id/CBEnableWineDebug"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_wine_debug" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/LLWineDebugChannels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="4dp" />
                    </HorizontalScrollView>

                    <View style="@style/FieldSeparator" />

                    <CheckBox
                        android:id="@+id/CBEnableBox64Logs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_box64_logs"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/TVLogs"
                    style="@style/FieldSetLabel"
                    android:text="@string/logs" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/CBEnableFileProvider"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/enable_file_provider" />

                        <ImageView
                            android:id="@+id/BTHelpFileProvider"
                            android:layout_gravity="center"
                            style="@style/HelpButton" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" >

                        <CheckBox
                            android:id="@+id/CBOpenWithAndroidBrowser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:text="@string/open_with_android_browser" />

                        <CheckBox
                            android:id="@+id/CBShareAndroidClipboard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:text="@string/share_android_clipboard" />

                        <CheckBox
                            android:id="@+id/CBPauseResumeWine"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:text="@string/pause_resume_wine" />

                        <CheckBox
                            android:id="@+id/CBHighRefreshRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:text="@string/high_refresh_rate" />

                        <CheckBox
                            android:id="@+id/CBRemoveLoadingBarWhenBootingGames"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:text="@string/remove_loading_bar_when_booting_games" />

                        <View style="@style/FieldSeparator" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/zh_hc_downloadable_contents_url_4bb92d9d" />

                        <EditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="left|center"
                            android:id="@+id/ETDownloadableContentsURL"/>

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/TVExperimental"
                    style="@style/FieldSetLabel"
                    android:text="@string/experimental" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout style="@style/FieldSet">

                    <Button
                        style="@style/ButtonPositive"
                        android:id="@+id/BTReInstallImagefs"
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/reinstall_imagefs" />

                </LinearLayout>

                <TextView
                    android:id="@+id/TVImageFs"
                    style="@style/FieldSetLabel"
                    android:text="@string/imagefs" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/BTConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|bottom"
        android:tint="@color/ui_text_primary"
        android:src="@drawable/icon_confirm"
        android:layout_margin="18dp"
        app:backgroundTint="@color/ui_surface_alt" />
</FrameLayout>
